import Maxwell.Continuum.FourierTensorModePower
import Maxwell.Continuum.FourierTensorModeTable

/-! An allocated, finite Fourier row table is generated by one fixed
program from the represented calibrated mode. Its values are the literal
rounded physical coefficients used by the compact-template encoder. -/
namespace Maxwell.Continuum.Profile.WaveMachine.Runtime.ModeAllocation
open Maxwell.Cost Maxwell.Cost.Structured RationalDataflow PartArray Calibration
open RationalAccumulator (Word Blank)
set_option maxHeartbeats 5000000
set_option maxRecDepth 16384

def generatedCode (j : Fin 3) : Code := .seq allocatedCode
  (.seq DyadicFloor.StoredPower.powerCode (ModePrepare.tableCode j))
def generatedTable (M L R P : ℕ) (a : Table (2*aliasArraySize R)) (j : Fin 3)
    (v : ℕ→Parts) (memory : ℕ→Bool) : Table (5*RowArithmetic.rowCount R) :=
  (buffer M L R P a memory).filled (ModePrepare.entries P R a j (ModePrepare.canonical v)) 0

theorem generated_cost (n P W A H Z : ℕ) :
    2^140*(A+H+Z+3)^2+(2^10*(P+2)^2+2^215*(n+1)*(P+W+12)^2)≤
      2^218*(n+1)*(P+W+A+H+Z+20)^2 := by
  let X := P+W+A+H+Z+20
  have ha : (A+H+Z+3)^2≤X^2 := Nat.pow_le_pow_left (by dsimp [X];omega) 2
  have hp : (P+2)^2≤X^2 := Nat.pow_le_pow_left (by dsimp [X];omega) 2
  have hw : (P+W+12)^2≤X^2 := Nat.pow_le_pow_left (by dsimp [X];omega) 2
  have hrow := Nat.mul_le_mul_left (2^215*(n+1)) hw
  have hs : X^2≤(n+1)*X^2 := Nat.le_mul_of_pos_left _ (by omega)
  change _≤2^218*(n+1)*X^2
  nlinarith only [ha,hp,hrow,hs,Nat.zero_le (X^2)]

theorem generated_executes {p : ℕ} (M A L R P W Wsetup H : ℕ) [NeZero M]
    (hW : 2≤W) (hsetup : 5≤Wsetup)
    (a : Table (2*aliasArraySize R)) (old : Table p) (j : Fin 3) (v : ℕ→Parts)
    (hma : a.MetadataWidth W) (hmo : old.MetadataWidth H)
    (hw : WidthBank RowArithmetic.bank W v) (hg : Good RowArithmetic.bank v)
    (hav : ∀i,(a.get i).Valid) (hR : R.bits.length≤W)
    (hsize : (aliasArraySize R).bits.length≤W) (hcount : (RowArithmetic.rowCount R).bits.length≤W)
    (hnorm : (v 0).value=Supercell.physicalFactorApprox M A)
    (hscale : v 1=FrequencyScaleMachine.result M L)
    (hmode : ‖(GlobalPower.tableData R a).value‖≤2)
    (hiw : InputWidth M L R P (addressValue a.width) (addressValue a.basePositive)
      (addressValue a.baseNegative) (addressValue a.baseDenominator) Wsetup)
    (input : List Bool) (tape : ℕ→Bool) (s : Store)
    (hmb : (buffer M L R P a s.val.memory).MetadataWidth W)
    (hb : NatAssign.Bank ids (initial M L R P (addressValue a.width) (addressValue a.basePositive)
      (addressValue a.baseNegative) (addressValue a.baseDenominator)) s.val)
    (hr : RationalDataflow.Ready RowArithmetic.bank (ModePrepare.canonical v) s)
    (ha : a.Ready s) (ho : old.OutputReady s) (hz216 : Blank s.val 216)
    (hz : DyadicFloor.Clean s.val) (h144 : Blank s.val 144) (h146 : Blank s.val 146) :
    ∃cost t ys origin,Executes input tape (generatedCode j) cost s t ∧
      cost≤2^218*(RowArithmetic.rowCount R+1)*(P+W+Wsetup+H+slotWidth M L R P+20)^2 ∧
      ModePrepare.TableState P R a (buffer M L R P a s.val.memory) j v s.val.output 0 t ∧
      (generatedTable M L R P a j v s.val.memory).OutputReady t ∧
      FourierRows (generatedTable M L R P a j v s.val.memory)
        (fun r => Supercell.templateFrequency M (L:ℚ) (RowArithmetic.rowAlias R r))
        (fun r => roundFourierCoefficient P (Supercell.physicalCoefficientData M A (GlobalPower.tableData R a))
          (RowArithmetic.rowAlias R r) j) ∧
      t.val.tapes 201=BitTape.shifted ys origin ∧ ys.length≤W := by
  let b := buffer M L R P a s.val.memory
  obtain ⟨c0,u,e0,hc0,r0,a0,b0,n0,cnt0,prec0,_,f0⟩ := allocated_executes M L R P Wsetup H hsetup a old hiw hmo
    RowArithmetic.bank (ModePrepare.canonical v) input tape s hb hr ha ho hz216
  obtain ⟨c1,w,e1,hc1,r1,a1,b1,n1,cnt1,z1,p1,_,f1⟩ := power_executes a b RowArithmetic.bank
    (ModePrepare.canonical v) R P input tape u r0 a0 b0 n0 cnt0 prec0 (floor_allocated_frame hz f0)
    (RationalAccumulator.blank_of_eq (f0.tapes 144 (by decide)) h144)
    (RationalAccumulator.blank_of_eq (f0.tapes 146 (by decide)) h146)
  obtain ⟨origin,counter⟩ := cnt1
  have fit (r : Fin (RowArithmetic.rowCount R)) (k : Fin 5) :
      (ModePrepare.fields P R a j r (ModePrepare.canonical v) k).Width (addressValue b.width) := by
    change (ModePrepare.fields P R a j r (ModePrepare.canonical v) k).Width
      (addressValue (slotWidth M L R P).bits)
    rw [addressValue_bits]
    exact generated_fit M A L R P a j v hnorm hscale hmode r k
  have hpos : 0<addressValue b.width := by
    change 0<addressValue (slotWidth M L R P).bits
    rw [addressValue_bits]
    exact slotWidth_pos M L R P
  have hsep : b.Separated := Profile.Runtime.memoryTable_separated _ _ _ _ _
  have hdisj : a.SeparatedFrom b := input_separated M L R P a s.val.memory
  obtain ⟨c2,t,ys,e2,hc2,final,word,length⟩ := ModePrepare.table_executes P R W hW a b j v hma hmb hw hg hav hR hsize
    (fun r => ModePrepare.writePlan_fit P R (addressValue b.width) a j r (ModePrepare.canonical v) (fit r))
    hpos hsep hdisj input tape (RowArithmetic.rowCount R).bits origin hcount (addressValue_bits _)
    w counter r1 a1 b1 n1 z1 p1
  have final' : ModePrepare.TableState P R a b j v s.val.output 0 t := by
    simpa only [f1.output,f0.output] using final
  have rows : FourierRows (generatedTable M L R P a j v s.val.memory)
      (fun r => Supercell.templateFrequency M (L:ℚ) (RowArithmetic.rowAlias R r))
      (fun r => roundFourierCoefficient P (Supercell.physicalCoefficientData M A (GlobalPower.tableData R a))
        (RowArithmetic.rowAlias R r) j) := by
    apply ModePrepare.generated_fourierRows M A P R (L:ℚ) a b j (ModePrepare.canonical v)
    · simpa only [ModePrepare.canonical,show ¬(2≤0 ∧ 0<28) by decide,ite_false] using hnorm
    · simp only [ModePrepare.canonical,show ¬(2≤1 ∧ 1<28) by decide,ite_false,hscale,
        FrequencyScaleMachine.result_value]
    · exact ModePrepare.canonical_good v hg
    · exact hav
    · exact fit
  refine ⟨c0+(c1+c2),t,ys,origin,e0.seq (e1.seq e2),?_,final',final'.destination,rows,word,length.trans_le hcount⟩
  exact (Nat.add_le_add hc0 (Nat.add_le_add hc1 hc2)).trans
    (generated_cost (RowArithmetic.rowCount R) P W Wsetup H (slotWidth M L R P))

#print axioms generated_executes
end Maxwell.Continuum.Profile.WaveMachine.Runtime.ModeAllocation
