import Maxwell.Continuum.FourierTensorAliasStep

/-! The fixed alias countdown computes the complete tensor numerator.
Every Fourier row and every wave coefficient is read or generated by
the executed code; the invariant's width growth is discharged here. -/
namespace Maxwell.Continuum.Profile.WaveMachine.Runtime
open Maxwell.Cost Maxwell.Cost.Structured Maxwell.Cost.RationalAccumulator RationalDataflow
open RationalDataflow.PartArray
open scoped BigOperators
set_option maxHeartbeats 6000000
set_option maxRecDepth 16384

def aliasNumerator {n B : ℕ} (q : Fin n→Fin 3→ℚ) (amp : Fin n→ComplexDyadic B)
    (Q N : ℕ) (j : Fin 3→ℕ) (r : ℕ) : ℚ :=
  if hr : r<n then
    ((complexDyadicMul (amp ⟨r,hr⟩) (complexDyadicTriple
      (fun i => waveRoundedCoefficient (q ⟨r,hr⟩ i) Q N (j i)))).1.numerator:ℚ)
  else 0

def aliasAccumulatorWidth (n remaining W : ℕ) : ℕ := W+(n-remaining)*(22*W+23)
def aliasLoopCode : Code := countedProgram 1099 aliasStepCode
def aliasLoopCost (Q N n W k : ℕ) (j : Fin 3→ℕ) : ℕ :=
  (n+1)*(13*k+15)+n*aliasStepCost Q N (aliasAccumulatorWidth n 0 W) W k j

structure AliasState {n B : ℕ} (a : Table (5*n)) (q : Fin n→Fin 3→ℚ)
    (amp : Fin n→ComplexDyadic B) (Q N W : ℕ) (j : Fin 3→ℕ)
    (initial : Table (2*(waveDegree (8*Q) N+1))) (initialAccumulator : ℚ)
    (remaining : ℕ) (s : Store) where
  remaining_le : remaining ≤ n
  values : ℕ→Parts
  table : Table (2*(waveDegree (8*Q) N+1))
  ready : FactorReady a Q N table values s
  fullReady : Ready termBank values s
  smallWidth : WidthBank tensorBank W values
  accumulatorWidth : (values 32).Width (aliasAccumulatorWidth n remaining W)
  accumulatorValid : (values 32).Valid
  accumulatorDenominator : (values 32).denominator=1
  metadata : CacheTableMetadata table initial
  indices : ∀i : Fin 3,(values (17+i.val)).positive=j i
  sumValue : (values 32).value=initialAccumulator+
    ∑r∈Finset.Ico remaining n,aliasNumerator q amp Q N j r
  queryIndex : ℕ
  queryWidth : queryIndex.bits.length ≤ W
  queryWord : Word s.val 1048 queryIndex

def AliasState.countState {n B Q N W remaining : ℕ} {a : Table (5*n)}
    {q : Fin n→Fin 3→ℚ} {amp : Fin n→ComplexDyadic B} {j : Fin 3→ℕ}
    {initial : Table (2*(waveDegree (8*Q) N+1))} {initialAccumulator : ℚ} {s t : Store}
    (h : AliasState a q amp Q N W j initial initialAccumulator remaining s)
    (f : CountedShifted.Frame 1099 s t) :
    AliasState a q amp Q N W j initial initialAccumulator remaining t :=
  { h with
    ready := h.ready.alias_count_frame f
    fullReady := Ready.count_frame termBank h.values 1099 (by decide) h.fullReady f
    queryWord := word_of_eq (f.2.2.2.2.2.1 1048 (by decide)) h.queryWord }

theorem aliasAccumulatorWidth_step {n r W : ℕ} (h : r<n) :
    aliasAccumulatorWidth n (r+1) W+22*W+23=aliasAccumulatorWidth n r W := by
  have he : n-r=(n-(r+1))+1 := by omega
  unfold aliasAccumulatorWidth
  rw [he,Nat.add_mul,Nat.one_mul]
  omega

theorem aliasAccumulatorWidth_le (n r W : ℕ) :
    aliasAccumulatorWidth n r W ≤ aliasAccumulatorWidth n 0 W := by
  unfold aliasAccumulatorWidth
  simp only [Nat.sub_zero]
  exact Nat.add_le_add_left (Nat.mul_le_mul_right _ (Nat.sub_le n r)) W

theorem aliasLoop_executes {n B : ℕ} (a : Table (5*n)) (Q N W : ℕ)
    (b : Table (2*(waveDegree (8*Q) N+1))) (hma : a.MetadataWidth W)
    (hm : b.MetadataWidth (producerWidth Q N W)) (hsep : b.Separated) (hdisjoint : a.SeparatedFrom b)
    (hfit : waveWorkBits (8*Q) N+7 ≤ addressValue b.width)
    (q : Fin n→Fin 3→ℚ) (amp : Fin n→ComplexDyadic B) (hrows : FourierRows a q amp)
    (hq : ∀r i,|q r i| ≤ Q) (j : Fin 3→ℕ) (hj : ∀i,j i<waveDegree (8*Q) N+1)
    (v : ℕ→Parts) (hw : WidthBank tensorBank W v) (ha : (v 32).Width W)
    (hvalid : (v 32).Valid) (hden : (v 32).denominator=1)
    (hindices : ∀i : Fin 3,(v (17+i.val)).positive=j i)
    (hQ : Q.bits.length ≤ W) (hN : N.bits.length ≤ W) (hW : 6 ≤ W)
    (hprecision : waveWorkBits (8*Q) N+7 ≤ W) (hgrid : (waveGrid (8*Q) N).bits.length ≤ W)
    (oldIndex : ℕ) (hold : oldIndex.bits.length ≤ W)
    (input : List Bool) (tape : ℕ→Bool) (xs : List Bool) (origin : ℤ) (hlen : xs.length ≤ W)
    (hn : addressValue xs=n) (s : Store) (hs : FactorReady a Q N b v s)
    (hr : Ready termBank v s) (hindex : Word s.val 1048 oldIndex)
    (hcount : s.val.tapes 1099=BitTape.shifted xs origin) :
    ∃cost t finalWord,Executes input tape aliasLoopCode cost s t ∧ cost ≤ aliasLoopCost Q N n W xs.length j ∧
      Nonempty (AliasState a q amp Q N W j b (v 32).value 0 t) ∧
      t.val.tapes 1099=BitTape.shifted finalWord origin ∧ finalWord.length=xs.length := by
  have indexWidth (i : Fin 3) : (j i).bits.length ≤ W := by
    have hi : 17+i.val∈tensorBank := by have := i.isLt;simp [tensorBank,Finset.mem_Ico];omega
    simpa only [hindices i] using (hw (17+i.val) hi).1
  let initial : AliasState a q amp Q N W j b (v 32).value n s := {
    remaining_le := le_rfl
    values := v
    table := b
    ready := hs
    fullReady := hr
    smallWidth := hw
    accumulatorWidth := by simpa [aliasAccumulatorWidth] using ha
    accumulatorValid := hvalid
    accumulatorDenominator := hden
    metadata := CacheTableMetadata.refl b
    indices := hindices
    sumValue := by simp
    queryIndex := oldIndex
    queryWidth := hold
    queryWord := hindex }
  let inv : ℕ→Store→Prop := fun r t => Nonempty (AliasState a q amp Q N W j b (v 32).value r t)
  let budget := aliasStepCost Q N (aliasAccumulatorWidth n 0 W) W xs.length j
  have stable : ∀r s t,CountedShifted.Frame 1099 s t → inv r s → inv r t := by
    intro r s t f ⟨state⟩
    exact ⟨state.countState f⟩
  have step : ∀r ys s,inv (r+1) s → s.val.tapes 1099=BitTape.shifted ys origin →
      addressValue ys=r → ys.length=xs.length →
      ∃cost t,Executes input tape aliasStepCode cost s t ∧ inv r t ∧
        t.val.tapes 1099=BitTape.shifted ys origin ∧ cost ≤ budget := by
    intro r ys s ⟨state⟩ hword hvalue hlength
    have hrl : r<n := by have := state.remaining_le;omega
    obtain ⟨cost,t,w,output,e,hcost,ready,full,width,acc,metadata,indices,valid,den,result,query,count⟩ :=
      aliasStep_executes a Q N (aliasAccumulatorWidth n (r+1) W) W state.table hma
        (state.metadata.widthBound hm) (state.metadata.separated hsep)
        (state.metadata.separatedFrom hdisjoint) (by simpa only [state.metadata.width] using hfit)
        q amp hrows hq j hj state.values state.smallWidth (by unfold aliasAccumulatorWidth;omega)
        state.accumulatorWidth state.accumulatorValid state.indices hQ hN hW hprecision hgrid
        state.queryIndex state.queryWidth input tape ys (by omega) ⟨r,hrl⟩ hvalue s
        state.ready state.fullReady state.queryWord ⟨origin,hword⟩
    have acc' : (w 32).Width (aliasAccumulatorWidth n r W) := by
      simpa only [aliasAccumulatorWidth_step hrl] using acc
    have result' : (w 32).value=(v 32).value+
        ∑k∈Finset.Ico r n,aliasNumerator q amp Q N j k := by
      rw [result,state.sumValue,Finset.sum_eq_sum_Ico_succ_bot hrl]
      simp only [aliasNumerator,dite_eq_left hrl]
      ring
    let next : AliasState a q amp Q N W j b (v 32).value r t := {
      remaining_le := hrl.le
      values := w
      table := output
      ready := ready
      fullReady := full
      smallWidth := width
      accumulatorWidth := acc'
      accumulatorValid := valid
      accumulatorDenominator := den.trans state.accumulatorDenominator
      metadata := metadata.trans state.metadata
      indices := indices
      sumValue := result'
      queryIndex := j 2
      queryWidth := indexWidth 2
      queryWord := query }
    refine ⟨cost,t,e,⟨next⟩,count.trans hword,?_⟩
    rw [hlength] at hcost
    exact hcost.trans (aliasStepCost_mono j (aliasAccumulatorWidth_le n (r+1) W))
  obtain ⟨cost,t,finalWord,e,state,word,length,_,hcost⟩ := counted_executes_sized 1099 origin aliasStepCode
    input tape xs.length inv (fun _ => budget) stable step n xs s hn hcount rfl ⟨initial⟩
  refine ⟨cost,t,finalWord,e,?_,state,word,length⟩
  simpa only [Finset.sum_const,Finset.card_range,smul_eq_mul,aliasLoopCost,budget] using hcost

#print axioms aliasLoop_executes
end Maxwell.Continuum.Profile.WaveMachine.Runtime
