import Maxwell.Continuum.DyadicFloorStoredPowerCost
import Maxwell.Cost.PowerOfTwo

/-! The scale consumed by the fixed floor is generated by a charged loop.
The exponent is an ordinary runtime word; no growing literal is in the code. -/
namespace Maxwell.Continuum.RationalDataflow.DyadicFloor.StoredPower
open Maxwell.Cost Maxwell.Cost.Structured Maxwell.Cost.RationalAccumulator
set_option maxHeartbeats 3000000
set_option maxRecDepth 8192

def powerCode : Code := .seq (PowerOfTwo.code 145 146 144) (.call (Rewind.program 144))

theorem power_executes (P : ℕ) (input : List Bool) (tape : ℕ→Bool) (s : Store)
    (hp : Word s.val 145 P) (hc : Blank s.val 146) (ht : Blank s.val 144) :
    ∃ cost t,Executes input tape powerCode cost s t ∧ cost≤2^10*(P+2)^2 ∧
      Word t.val 145 P ∧ Word t.val 144 (2^P) ∧ Blank t.val 146 ∧
      BinaryPrecision.Frame {144,146} s.val t.val := by
  obtain ⟨so,hp⟩ := hp
  obtain ⟨co,hc⟩ := hc
  obtain ⟨targetOrigin,ht⟩ := ht
  obtain ⟨cost,u,ex,hcost,huS,huC,huT,hf⟩ := PowerOfTwo.executes 145 146 144
    (by decide) (by decide) (by decide) input tape P.bits so co targetOrigin s hp hc ht
  rw [addressValue_bits] at hcost huT
  have hr := WordTransfer.rewind_shifted 144 targetOrigin input tape (2^P).bits u.val u.property huT
  let t := Store.ofState (Rewind.finishAt 144 targetOrigin u.val)
  have er : Executes input tape (.call (Rewind.program 144)) (4*(2^P).bits.length+6) u t :=
    Executes.call _ u _ _ hr.1 (by simp [Rewind.program,Rewind.finishAt])
  have fr := WordTransfer.frame_rewind 144 144 144 (Or.inl rfl) targetOrigin u.val
  have hwidth : (2^P:ℕ).bits.length=P+1 := by rw [Nat.size_eq_bits_len,Nat.size_pow]
  have hP : P.bits.length≤P := by
    rw [Nat.size_eq_bits_len,Nat.size_le]
    exact Nat.lt_two_pow_self
  refine ⟨cost+(4*(2^P).bits.length+6),t,ex.seq er,?_,?_,⟨targetOrigin,hr.2⟩,?_,?_⟩
  · rw [hwidth]
    have hproduct := Nat.mul_le_mul_left (P+1) (show 13*P.bits.length+21≤13*P+21 by omega)
    nlinarith only [hcost,hproduct,hP]
  · exact ⟨so,(fr.2.2.2.2.2.1 145 (by decide) (by decide)).trans huS⟩
  · exact ⟨co+P.bits.length,(fr.2.2.2.2.2.1 146 (by decide) (by decide)).trans huC⟩
  · refine ⟨fr.1.trans hf.1,fr.2.1.trans hf.2.1,fr.2.2.1.trans hf.2.2.1,
      fr.2.2.2.1.trans hf.2.2.2.1,fr.2.2.2.2.1.trans hf.2.2.2.2.1,?_⟩
    intro i hi
    simp only [Finset.mem_insert,Finset.mem_singleton,not_or] at hi
    exact (fr.2.2.2.2.2.1 i hi.1 hi.1).trans (hf.2.2.2.2.2.1 i hi.2 hi.1)

#print axioms power_executes
end Maxwell.Continuum.RationalDataflow.DyadicFloor.StoredPower
