import Maxwell.Continuum.SourceRoutingLevelCanonical
import Maxwell.Continuum.SourceRoutingTreeChildren

/-! The next level consumes exactly the children generated by the prior
level, with no assumed memory snapshot or supplied permutation arrays. -/

namespace Maxwell.Cost.RoutingPorts.Complete.Tree.Level
set_option maxRecDepth 16384
set_option maxHeartbeats 2200000

def nextTargets (rows columns d : ℕ)
    (parent : Fin (2^d)→Targets.Target rows (columns+1+1)) :
    Fin (2^(d+1))→Targets.Target rows (columns+1) := fun i =>
  ColorData.childTarget rows (columns+1) (parent (Targets.parent d i)) (Targets.bit i)

theorem inputs_from_parents (rows columns d heap rootCount rootWidth L : ℕ) (v : ℕ→ℕ)
    (parent : Fin (2^d)→Targets.Target rows (columns+1+1))
    (hL : 1 ≤ L)
    (hn : 2*(2*2^(columns+rows)) ≤ rootCount) (hw : columns+rows+3 ≤ rootWidth)
    (hs : Coordinates.Stored v heap rootCount rootWidth (d+1)
      (2*2^(columns+rows)) (columns+rows+2) 0)
    (hz : ∀j∈Maxwell.Continuum.RationalDataflow.NaturalQuotient.workPorts,v j=0)
    (hv : ∀j∈Division.ids,(v j).bits.length ≤ L) (hp : (2^(d+1)).bits.length ≤ L)
    (memory : ℕ→Bool)
    (stored : ∀i : Fin (2^d),Outputs.At heap rootCount rootWidth (levelNode d i)
      rows (columns+1) (parent i) memory) :
    (ofCoordinates rows columns d heap rootCount rootWidth L v (nextTargets rows columns d parent)
      hL hn hw hs hz hv hp).Inputs memory := by
  intro i
  change Fin (2^(d+1)) at i
  change BitArray.Represents memory (Descriptor.output (values v i.val) 803) (columns+rows+2)
      (DoublingPass.words (columns+rows+2) (Vector.ofFn
        (ColorData.splitData rows columns (nextTargets rows columns d parent i)).target)) ∧
    BitArray.Represents memory (Descriptor.output (values v i.val) 804) (columns+rows+2)
      (DoublingPass.words (columns+rows+2) (Vector.ofFn
        (ColorData.splitData rows columns (nextTargets rows columns d parent i)).target.symm))
  have hc : Coordinates.Stored (values v i.val) heap rootCount rootWidth (d+1)
      (2*2^(columns+rows)) (columns+rows+2) (Targets.child d (Targets.parent d i) (Targets.bit i)).val := by
    rw [Targets.child_parent]
    exact coordinates_values v heap rootCount rootWidth (d+1) _ _ hs i.val
  have addresses:=And.intro
    (Coordinates.forward_eq (values v i.val) heap rootCount rootWidth d _ _ (Targets.parent d i) (Targets.bit i) hc)
    (Coordinates.backward_eq (values v i.val) heap rootCount rootWidth d _ _ (Targets.parent d i) (Targets.bit i) hc)
  have children:=(stored (Targets.parent d i)).children (Targets.bit i)
  have size : 2*2^(columns+1+rows)=2*(2*2^(columns+rows)) := by
    rw [show columns+1+rows=(columns+rows)+1 by omega,pow_succ']
  have width : columns+1+rows+2=(columns+rows+2)+1 := by omega
  have childWidth : columns+1+rows+1=columns+rows+2 := by omega
  rw [size,width,childWidth] at children
  constructor
  · apply (Storage.split_target rows columns (nextTargets rows columns d parent i) memory _ _).mp
    rw [addresses.1]
    exact children.1
  · apply (Storage.split_inverse rows columns (nextTargets rows columns d parent i) memory _ _).mp
    rw [addresses.2]
    exact children.2

theorem completed_outputs (rows columns d heap rootCount rootWidth L : ℕ) (v : ℕ→ℕ)
    (target : Fin (2^(d+1))→Targets.Target rows (columns+1))
    (hL : 1 ≤ L)
    (hn : 2*(2*2^(columns+rows)) ≤ rootCount) (hw : columns+rows+3 ≤ rootWidth)
    (hs : Coordinates.Stored v heap rootCount rootWidth (d+1)
      (2*2^(columns+rows)) (columns+rows+2) 0)
    (hz : ∀j∈Maxwell.Continuum.RationalDataflow.NaturalQuotient.workPorts,v j=0)
    (hv : ∀j∈Division.ids,(v j).bits.length ≤ L) (hp : (2^(d+1)).bits.length ≤ L)
    (memory : ℕ→Bool)
    (hdone : (ofCoordinates rows columns d heap rootCount rootWidth L v target
      hL hn hw hs hz hv hp).Done (2^(d+1)) memory) :
    ∀i : Fin (2^(d+1)),Outputs.At heap rootCount rootWidth (levelNode (d+1) i)
      rows columns (target i) memory := by
  intro i
  let p:=ofCoordinates rows columns d heap rootCount rootWidth L v target hL hn hw hs hz hv hp
  let idx : Fin p.nodes:=⟨i.val,i.isLt⟩
  have hh:=hdone idx idx.isLt
  change Outputs.Stored (p.layout idx) (columns+rows) (p.data idx) memory at hh
  rw [p.layout_eq idx] at hh
  exact (Outputs.at_iff heap rootCount rootWidth (levelNode (d+1) i) rows columns _ _ (target i) memory).mp hh

#print axioms inputs_from_parents
#print axioms completed_outputs
end Maxwell.Cost.RoutingPorts.Complete.Tree.Level
