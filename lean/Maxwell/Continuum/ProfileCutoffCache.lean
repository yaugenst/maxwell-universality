import Maxwell.Continuum.ProfileMonomialCache
import Maxwell.Continuum.CutoffCacheAntiderivative
import Maxwell.Continuum.CutoffStoredQuery
import Maxwell.Continuum.RationalDataflowProgramFootprint

/-! The profile output is converted into the literal coefficient table used
by cutoff queries. The table is generated by the fixed executed program;
its value certificate is a conclusion of that execution. -/
namespace Maxwell.Continuum.Profile.Runtime
open RationalDataflow RationalDataflow.PartArray Maxwell.Cost Maxwell.Cost.Structured
open Calibration.RawCutoff
open RationalAccumulator (Blank)
set_option maxHeartbeats 4000000
set_option maxRecDepth 32768
attribute [local irreducible] profileDegree runtimeBudget

def cutoffCacheWidth (N : ℕ) : ℕ :=
  scaleWorkingWidth (profileDegree N) (monomialStorageWidth (profileDegree N) (cacheSourceWidth N))

def cutoffCacheCode : Code := .seq monomialCacheCode antiderivativePreparationCode

def cutoffCacheCost (N : ℕ) : ℕ := monomialCacheCost N+
  antiderivativePreparationCost (profileDegree N)
    (monomialStorageWidth (profileDegree N) (cacheSourceWidth N))
    (profileDegree N).bits.length (monomialWorkingWidth (profileDegree N) (cacheSourceWidth N))

structure CutoffTable (N : ℕ) where
  heapEnd : ℕ
  table : Table (profileDegree N)
  spare : Table (4*(profileDegree N+1))
  tableEnd : table.EndsBefore heapEnd
  spareEnd : spare.EndsBefore heapEnd
  spareMetadata : spare.MetadataWidth (cutoffCacheWidth N)
  metadata : table.MetadataWidth (cutoffCacheWidth N)
  width : ∀i,(table.get i).Width (cutoffCacheWidth N)
  valid : ∀i,(table.get i).Valid
  value : ∀i,(table.get i).value=(antiderivativeCoefficient N i).value

theorem cutoffCache_executes {N heap : ℕ} {memory : ℕ→Bool} (s : Store)
    (r : EncodedTableResult N (runtimeBudget N) (finalBuffer N heap memory) s)
    (hh : heap.bits.length≤producerSize N)
    (hN : RationalAccumulator.Word s.val 660 N)
    (hheap : RationalAccumulator.Word s.val 709 (cacheSourceHeap N heap))
    (hclean : ∀i∈cacheDimensionIds,Blank s.val i)
    (hblank : ∀i∈RowIndex.ids,Blank s.val i)
    (hcontrol : ∀i∈({206,207,208,209}:Finset ℕ),Blank s.val i)
    (input : List Bool) (tape : ℕ→Bool) :
    ∃(cost : ℕ) (t : Store) (result : CutoffTable N) (bank : ℕ→Parts) (word : List Bool),
      Executes input tape cutoffCacheCode cost s t ∧ cost≤cutoffCacheCost N ∧
      result.table.Ready t ∧ result.spare.OutputReady t ∧ RationalDataflow.Ready scaleSlots bank t ∧
      WidthBank scaleSlots (cutoffCacheWidth N) bank ∧ Good scaleSlots bank ∧
      BankArray.Word t.val 206 (profileDegree N).bits ∧ BankArray.Word t.val 201 word ∧
      word.length=(profileDegree N).bits.length ∧ Blank t.val 216 ∧
      NatAssign.Bank cacheDimensionIds
        (cacheNaturalValues (profileDegree N) (cacheSourceWidth N) (cacheSourceHeap N heap)) t.val ∧
      RationalAccumulator.Word t.val 709 (cacheSourceHeap N heap) ∧
      result.heapEnd=cacheEndBase (profileDegree N) (cacheSourceWidth N) (cacheSourceHeap N heap) := by
  obtain ⟨c0,s0,cache,e0,hc0,valid0,ready0,natural0,heap0,end0,coeff0⟩ :=
    monomialCache_executes s r hh hN hheap hclean hblank hcontrol input tape
  let D := profileDegree N
  let W := cacheSourceWidth N
  have hD : 0<D := lt_of_lt_of_le (by decide : (0:ℕ)<2) (profileDegree_two N)
  have hlen : D.bits.length≤monomialWorkingWidth D W := by
    have hd := cache_nat_bits_le D
    unfold monomialWorkingWidth monomialStorageWidth
    omega
  obtain ⟨c1,t,word,e1,hc1,rt,at',spare,saved,count,hl,swap,meta',width,good,coeff⟩ :=
    cache.antiderivative_executes r.table.getD hD valid0 r.coefficients.2.1 r.coefficients.1
      input tape D.bits hlen (addressValue_bits D) s0 ready0
  have hs : scaleStateWidth D (monomialStorageWidth D W)≤cutoffCacheWidth N := by
    change scaleStateWidth D (monomialStorageWidth D W)≤scaleWorkingWidth D (monomialStorageWidth D W)
    unfold scaleWorkingWidth
    omega
  let result : CutoffTable N :=
    ⟨cacheEndBase D W (cacheSourceHeap N heap),cache.antiderivativeTable,cache.current,
      (end0.2.prefix (by omega)).filled _ _,end0.1,
      valid0.currentMetadata.mono (cache_antiderivative_widths D W).1,
      meta',fun i=>(coeff i).1.mono hs,fun i=>(coeff i).2.1,by
      intro i
      rw [(coeff i).2.2]
      exact monomialAntiderivativeValues_value N cache.current (fun i=>(coeff0 i).2.2) i⟩
  have keeps : antiderivativePreparationCode.protectsSet (insert 709 cacheDimensionIds)=true := by
    have hq : Parts.literal (1/4)=⟨1,0,4⟩ := by norm_num [Parts.literal]
    simp only [antiderivativePreparationCode,scalePreparationCode,scalePrepareInitial,
      Control.prepend,List.foldr_cons,List.foldr_nil,Control.code,Instruction.code,hq]
    decide
  have natural : NatAssign.Bank cacheDimensionIds (cacheNaturalValues D W (cacheSourceHeap N heap)) t.val := by
    intro i hi
    exact RationalAccumulator.word_of_eq (e1.protectsSet _ keeps i (Finset.mem_insert_of_mem hi)) (natural0 i hi)
  have heap' := RationalAccumulator.word_of_eq (e1.protectsSet _ keeps 709 (by simp)) heap0
  exact ⟨c0+c1,t,result,cache.antiderivativeBank,word,e0.seq e1,Nat.add_le_add hc0 hc1,
    at',spare,rt,width.mono hs,good,saved,count,hl,swap,natural,heap',rfl⟩

theorem CutoffTable.query {N : ℕ} (a : CutoffTable N)
    (v : ℕ→Parts) (W : ℕ) (hW : cutoffCacheWidth N≤W)
    (hw : WidthBank querySlots W v) (hg : Good querySlots v)
    (q₀ : ℝ) (x : Space)
    (hx : ∀i : Fin 3,|x i/q₀-((v (10+i.val)).value:ℝ)|≤(1/2:ℝ)^(N+12))
    (input : List Bool) (tape : ℕ→Bool) (ys : List Bool) (hy : ys.length≤W)
    (s : Store) (hsaved : BankArray.Word s.val 206 (profileDegree N).bits)
    (hcount : BankArray.Word s.val 201 ys)
    (hr : RationalDataflow.Ready querySlots v s) (ha : a.table.Ready s) :
    ∃(t : Store) (out : ℕ→Parts),
      (runPriced (storedCutoffQueryCode.compile.next input tape)
        (polynomialPlanCost (profileDegree N) W 42+1) s.val).finished=
          some (t.place storedCutoffQueryCode.size) ∧
      (runPriced (storedCutoffQueryCode.compile.next input tape)
        (polynomialPlanCost (profileDegree N) W 42+1) s.val).instructions≤
          polynomialPlanCost (profileDegree N) W 42 ∧
      RationalDataflow.Ready querySlots out t ∧ Good querySlots out ∧ a.table.Ready t ∧
      WidthBank querySlots (polynomialPlanWidth (profileDegree N) W 42) out ∧
      |Well.chi q₀ x-((out 16).value:ℝ)|≤(1/2:ℝ)^N := by
  have hb : 3≤cutoffCacheWidth N := by unfold cutoffCacheWidth scaleWorkingWidth;omega
  have hd : (profileDegree N).bits.length≤cutoffCacheWidth N := by
    have h := cache_nat_bits_le (profileDegree N)
    unfold cutoffCacheWidth scaleWorkingWidth scaleStateWidth monomialStorageWidth
    omega
  exact storedCutoffQuery_computes_enclosure N a.table a.value W (hb.trans hW)
    (fun i=>(a.width i).mono hW) a.valid (a.metadata.mono hW) v hw hg q₀ x hx
    input tape (profileDegree N).bits ys (hd.trans hW) hy s (addressValue_bits _)
    hsaved hcount hr ha

#print axioms cutoffCache_executes
#print axioms CutoffTable.query
end Maxwell.Continuum.Profile.Runtime
