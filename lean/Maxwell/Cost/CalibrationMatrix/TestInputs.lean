import Maxwell.Cost.CalibrationMatrix.WordSchedule
import Maxwell.Cost.CalibrationMatrix.TestWords
import Maxwell.Green.CalibrationTests

namespace Maxwell.Cost.CalibrationMatrix.TestInputs
open Structured BankArray WordSchedule
set_option maxRecDepth 4096
set_option maxHeartbeats 1200000

/-- The seven raw operands are row direction, three row coordinates, and
three column coordinates. The column direction is needed only by the later
fixed stencil selector. -/
def initial (clockWord : List Bool) (raw : Fin 7 → List Bool) (i : ℕ) : List Bool :=
  if i = 101 then clockWord else
  if i = 150 then raw 0 else if i = 151 then raw 1 else
  if i = 152 then raw 2 else if i = 153 then raw 3 else
  if i = 171 then raw 4 else if i = 172 then raw 5 else
  if i = 173 then raw 6 else []

def plan : List Op := [
  .successor 151 161, .successor 152 162, .successor 153 163,
  .successor 171 181, .successor 172 182, .successor 173 183,
  .successor 220 221, .successor 221 222,
  .pad 150 190, .pad 151 191, .pad 152 192, .pad 153 193,
  .pad 161 194, .pad 162 195, .pad 163 196,
  .pad 171 201, .pad 172 202, .pad 173 203,
  .pad 181 204, .pad 182 205, .pad 183 206,
  .pad 220 210, .pad 221 211, .pad 222 212]

def domain : Finset ℕ :=
  {101,150,151,152,153,171,172,173,220} ∪ WordSchedule.changes plan

def prepared (width : ℕ) (clockWord : List Bool) (raw : Fin 7 → List Bool) : ℕ → List Bool :=
  WordSchedule.run width plan (initial clockWord raw)

private theorem valid_iff (d : Finset ℕ) (c w : ℕ) (v : ℕ → List Bool) (op : Op) :
    Valid d c w v op ↔ op.source ∈ d ∧ op.target ∈ d ∧ 100 ≤ op.target ∧
      op.source ≠ op.target ∧ op.source ≠ c ∧ c ≠ op.target ∧
      v op.target = [] ∧ (v op.source).length ≤ w := by
  constructor
  · intro h; exact ⟨h.source_mem,h.target_mem,h.target_high,h.different,
      h.clock_source,h.clock_target,h.target_empty,h.source_length⟩
  · rintro ⟨hs,ht,hh,hn,hsc,hct,he,hl⟩; exact ⟨hs,ht,hh,hn,hsc,hct,he,hl⟩

theorem admissible (width : ℕ) (clockWord : List Bool) (raw : Fin 7 → List Bool)
    (hwidth : 2 ≤ width) (hraw : ∀ i, (raw i).length+1 ≤ width) :
    Admissible domain 101 width plan (initial clockWord raw) := by
  have hr (i : Fin 7) : (raw i).length ≤ width := by have := hraw i; omega
  have hs (i : Fin 7) : (Increment.bits (raw i)).length ≤ width :=
    (Increment.bits_length_le _).trans (hraw i)
  simp [Admissible, plan, valid_iff, domain, WordSchedule.changes, Op.source, Op.target,
    Op.apply, Op.result, initial, Increment.bits, Increment.carryBits, hr,
    show ∀ i : Fin 7, (Increment.carryBits true (raw i)).length ≤ width from hs,
    hwidth, show 1 ≤ width by omega]

/-- All comparison operands are generated by the fixed schedule; no words
are supplied by an equality or stencil oracle. -/
theorem prepare (width : ℕ) (clockWord : List Bool) (raw : Fin 7 → List Bool)
    (hwidth : 2 ≤ width) (hclock : clockWord.length = width)
    (hraw : ∀ i, (raw i).length+1 ≤ width) (input : List Bool) (tape : ℕ → Bool)
    (s : Store) (hb : Banks domain s (initial clockWord raw)) (hs : Scratch s.val) :
    ∃ cost t, cost ≤ 1488*(width+1)+1 ∧
      Executes input tape (WordSchedule.code 101 plan) cost s t ∧
      Banks domain t (prepared width clockWord raw) ∧ Scratch t.val ∧
      WordSchedule.Frame (WordSchedule.changes plan) s t := by
  obtain ⟨cost,t,hc,he,hb,hs,hf⟩ := WordSchedule.executes domain 101 width clockWord
    (by simp [domain]) hclock plan (initial clockWord raw) (by simp [initial])
    (admissible width clockWord raw hwidth hraw) input tape s hb hs
  refine ⟨cost,t,?_,he,hb,hs,hf⟩
  have hp : plan.length = 24 := rfl
  rw [hp] at hc
  omega

/-- The first three pairs test directions; the remaining nine test the
three possible offsets along each coordinate. -/
def left (i : Fin 12) : ℕ :=
  if i.val < 3 then 190 else
    if (i.val-3)%3 = 0 then 194+(i.val-3)/3 else 191+(i.val-3)/3

def right (i : Fin 12) : ℕ :=
  if i.val < 3 then 210+i.val else
    if (i.val-3)%3 = 2 then 204+(i.val-3)/3 else 201+(i.val-3)/3

def leftSource (raw : Fin 7 → List Bool) (i : Fin 12) : List Bool :=
  if i.val < 3 then raw 0 else
    if (i.val-3)%3 = 0 then Increment.bits (raw (Fin.ofNat 7 ((i.val-3)/3+1)))
    else raw (Fin.ofNat 7 ((i.val-3)/3+1))

def rightSource (raw : Fin 7 → List Bool) (i : Fin 12) : List Bool :=
  if i.val < 3 then i.val.bits else
    if (i.val-3)%3 = 2 then Increment.bits (raw (Fin.ofNat 7 ((i.val-3)/3+4)))
    else raw (Fin.ofNat 7 ((i.val-3)/3+4))

theorem prepared_left (width : ℕ) (clockWord : List Bool) (raw : Fin 7 → List Bool)
    (i : Fin 12) : prepared width clockWord raw (left i) =
      FixedWidth.bits width (leftSource raw i) := by
  fin_cases i <;> simp [prepared, WordSchedule.run, plan, Op.apply, Op.target,
    Op.result, initial, left, leftSource] <;> rfl

theorem prepared_right (width : ℕ) (clockWord : List Bool) (raw : Fin 7 → List Bool)
    (i : Fin 12) : prepared width clockWord raw (right i) =
      FixedWidth.bits width (rightSource raw i) := by
  fin_cases i <;> simp [prepared, WordSchedule.run, plan, Op.apply, Op.target,
    Op.result, initial, right, rightSource, Increment.bits, Increment.carryBits]
  rfl

theorem source_lengths (width : ℕ) (raw : Fin 7 → List Bool)
    (hwidth : 2 ≤ width) (hraw : ∀ i, (raw i).length+1 ≤ width) (i : Fin 12) :
    (leftSource raw i).length ≤ width ∧ (rightSource raw i).length ≤ width := by
  have hr (i : Fin 7) : (raw i).length ≤ width := by have := hraw i; omega
  have hs (i : Fin 7) : (Increment.bits (raw i)).length ≤ width :=
    (Increment.bits_length_le _).trans (hraw i)
  have htwo : (Nat.bits 2).length = 2 := by decide
  fin_cases i <;> simp [leftSource, rightSource, hr, hs, htwo] <;> omega

end Maxwell.Cost.CalibrationMatrix.TestInputs
