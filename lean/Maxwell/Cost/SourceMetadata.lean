import Maxwell.Cost.MagnitudeMax.Both
import Maxwell.Cost.BinaryPrecision

namespace Maxwell.Cost.SourceMetadata

open Structured RationalAccumulator

/-- Only these work tapes may change during scale and precision setup. -/
def work : Finset ℕ := {0, 1, 2, 3, 30, 31, 32, 33, 34, 35, 36, 68, 70, 71, 72, 73, 80, 82, 84}

def auxiliary : Finset ℕ := {68, 70, 71, 72, 73, 82, 83, 84, 85}

def code (k c : ℕ) : Code := .seq (DecoderTerm.multiplyCode 79 80)
  (.seq (BinaryPrecision.code 79 k c)
    (.seq (.call (WordTransfer.move 70 84)) (.seq (.call (WordTransfer.move 71 82)) resetCode)))

def costBound (m B k c : ℕ) : ℕ := 4000 * ((k + c + 12) * (m.size + B + 3))^2

theorem move (source target n : ℕ) (hne : source ≠ target)
    (input : List Bool) (tape : ℕ → Bool) (s : Store)
    (hs : Word s.val source n) (ht : Blank s.val target) :
    ∃ t : Store, Executes input tape (.call (WordTransfer.move source target))
      (12 * n.bits.length + 11) s t ∧ Word t.val target n ∧ Blank t.val source ∧
      BinaryPrecision.Frame {source, target} s.val t.val := by
  obtain ⟨origin, ho⟩ := hs
  obtain ⟨destination, hd⟩ := ht
  obtain ⟨t, he, hp, hsource, htarget, hf⟩ := WordTransfer.move_steps source target hne input tape
    n.bits origin destination s.val s.property ho hd
  refine ⟨Store.ofState t, Executes.call _ _ _ _ he (by rw [hp]; rfl),
    ⟨destination, htarget⟩, ⟨origin + n.bits.length, hsource⟩,
    hf.1, hf.2.1, hf.2.2.1, hf.2.2.2.1, hf.2.2.2.2.1, ?_⟩
  intro i hi
  simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hi
  exact hf.2.2.2.2.2.1 i hi.1 hi.2

theorem scratch_blank {s : BitRAMState} (h : Scratch s 0) : ∀ i, i < 4 → Blank s i := by
  intro i hi
  interval_cases i
  · exact h.1
  · exact (zero_word_iff_blank s 1).mp h.2.1
  · exact h.2.2.1
  · exact h.2.2.2

private theorem frame_product {s t : BitRAMState} (h : StoredProduct.Frame 80 s t) :
    BinaryPrecision.Frame work s t := by
  refine ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, h.2.2.2.2.1, ?_⟩
  intro i hi
  simp only [work, Finset.mem_insert, Finset.mem_singleton, not_or] at hi
  exact h.2.2.2.2.2.1 i (by omega) (by omega)

private theorem frame_bank {s t : BitRAMState} (h : RationalAccumulator.Frame s t) :
    BinaryPrecision.Frame work s t := by
  refine ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1, h.2.2.2.2.1, ?_⟩
  intro i hi
  simp only [work, Finset.mem_insert, Finset.mem_singleton, not_or] at hi
  exact h.2.2.2.2.2.1 i (by omega) (by omega)

set_option maxHeartbeats 800000 in
/-- The matrix scale is multiplied from the actual saved nonzero count;
precision and its power are measured/generated by finite programs. No
numeric input value is supplied as a runtime instruction constant. -/
theorem executes (m numerator B k c : ℕ) (rhs : MagnitudeMax.Pair)
    (hn : numerator.bits.length ≤ B)
    (hb : rhs.1.bits.length ≤ B ∧ rhs.2.bits.length ≤ B)
    (input : List Bool) (tape : ℕ → Bool) (s : Store)
    (hm : Word s.val 79 m) (ha : Word s.val 80 numerator)
    (hbank : Bank s.val (MagnitudeMax.bankOf rhs)) (hready : Scratch s.val 0)
    (haux : ∀ i ∈ auxiliary, Blank s.val i) :
    ∃ cost, ∃ t : Store, cost ≤ costBound m B k c ∧ Executes input tape (code k c) cost s t ∧
      Word t.val 80 (m * numerator) ∧
      Word t.val 84 (Realization.binaryCoefficientPrecision m k c) ∧
      Word t.val 82 (2 ^ Realization.binaryCoefficientPrecision m k c) ∧
      Bank t.val (fun _ => 0) ∧ Scratch t.val 0 ∧ Blank t.val 83 ∧ Blank t.val 85 ∧
      BinaryPrecision.Frame work s.val t.val := by
  obtain ⟨mc, u, hmc, hu, hu80, hub, huf⟩ := DecoderTerm.multiply 79 80
    (by decide) (by decide) (by decide) input tape m numerator s hm ha (scratch_blank hready)
  have hu79 : Word u.val 79 m := word_of_eq (huf.2.2.2.2.2.1 79 (by decide) (by decide)) hm
  have hubp : ∀ i ∈ BinaryPrecision.work, Blank u.val i := by
    intro i hi
    by_cases hsmall : i < 4
    · exact hub i hsmall
    · have hi' : i ∈ auxiliary := by
        simp only [BinaryPrecision.work, auxiliary, Finset.mem_insert, Finset.mem_singleton] at hi ⊢
        omega
      exact blank_of_eq (huf.2.2.2.2.2.1 i (by omega) (by
        simp only [auxiliary, Finset.mem_insert, Finset.mem_singleton] at hi'; omega)) (haux i hi')
  obtain ⟨pc, v, hv, hpc, hv70, hv71, hvb, _, hvf⟩ := BinaryPrecision.executes 79 m k c (by decide)
    input tape u hu79 hubp
  have hvaux (i : ℕ) (hi : i ∈ auxiliary) (hbp : i ∉ BinaryPrecision.work) (h4 : 4 ≤ i) (h80 : i ≠ 80) :
      Blank v.val i := blank_of_eq ((hvf.tapes i hbp).trans (huf.2.2.2.2.2.1 i h4 h80)) (haux i hi)
  obtain ⟨w, hw, hw84, _, hwf⟩ := move 70 84 (Realization.binaryCoefficientPrecision m k c) (by decide)
    input tape v hv70 (hvaux 84 (by decide) (by decide) (by decide) (by decide))
  obtain ⟨x, hx, hx82, _, hxf⟩ := move 71 82 (2 ^ Realization.binaryCoefficientPrecision m k c) (by decide)
    input tape w (word_of_eq (hwf.tapes 71 (by decide)) hv71)
    (blank_of_eq (hwf.tapes 82 (by decide)) (hvaux 82 (by decide) (by decide) (by decide) (by decide)))
  have hxb : Bank x.val (MagnitudeMax.bankOf rhs) := by
    intro i hi hi'
    exact word_of_eq ((hxf.tapes i (by simp; omega)).trans ((hwf.tapes i (by simp; omega)).trans
      ((hvf.tapes i (by simp [BinaryPrecision.work]; omega)).trans
        (huf.2.2.2.2.2.1 i (by omega) (by omega))))) (hbank i hi hi')
  have hxblank (i : ℕ) (hi : i < 4) : Blank x.val i :=
    blank_of_eq ((hxf.tapes i (by simp; omega)).trans (hwf.tapes i (by simp; omega))) (hvb i hi)
  have hxr : Scratch x.val 0 :=
    ⟨hxblank 0 (by decide), (zero_word_iff_blank x.val 1).mpr (hxblank 1 (by decide)),
      hxblank 2 (by decide), hxblank 3 (by decide)⟩
  obtain ⟨t, ht, htb, htr, htf⟩ := reset input tape (MagnitudeMax.bankOf rhs) x hxb hxr
  have hall : BinaryPrecision.Frame work s.val t.val :=
    ((((frame_product huf).trans (hvf.mono (by decide))).trans (hwf.mono (by decide))).trans
      (hxf.mono (by decide))).trans (frame_bank htf)
  have hpost (i : ℕ) (hi : 4 ≤ i) (hbank : i < 30 ∨ 36 < i)
      (hm1 : i ∉ ({70, 84} : Finset ℕ)) (hm2 : i ∉ ({71, 82} : Finset ℕ))
      (hbp : i ∉ BinaryPrecision.work) : t.val.tapes i = u.val.tapes i :=
    (htf.2.2.2.2.2.1 i hi hbank).trans ((hxf.tapes i hm2).trans ((hwf.tapes i hm1).trans (hvf.tapes i hbp)))
  refine ⟨_, t, ?_, hu.seq (hv.seq (hw.seq (hx.seq ht))),
    word_of_eq (hpost 80 (by decide) (Or.inr (by decide)) (by decide) (by decide) (by decide)) hu80,
    word_of_eq ((htf.2.2.2.2.2.1 84 (by decide) (Or.inr (by decide))).trans (hxf.tapes 84 (by decide))) hw84,
    word_of_eq (htf.2.2.2.2.2.1 82 (by decide) (Or.inr (by decide))) hx82,
    ?_, htr, blank_of_eq (hall.tapes 83 (by decide)) (haux 83 (by decide)),
    blank_of_eq (hall.tapes 85 (by decide)) (haux 85 (by decide)), hall⟩
  · let D := (k + c + 12) * (m.size + B + 3)
    let P := Realization.binaryCoefficientPrecision m k c
    have hD : 36 ≤ D := by dsimp [D]; nlinarith
    have hbase : m.size + B + 3 ≤ D := by dsimp [D]; nlinarith
    have hprec : (k + c + 12) * (m.size + 1) ≤ D := by dsimp [D]; nlinarith
    have hP : P + 1 ≤ D := by dsimp [P, Realization.binaryCoefficientPrecision, D]; nlinarith
    have hB : B ≤ D := by omega
    have hbits : P.bits.length ≤ P := by
      simpa only [WordLength.countBits_eq] using WordLength.countBits_length P
    have hpbits : (2 ^ P).bits.length = P + 1 := by rw [Nat.size_eq_bits_len, Nat.size_pow]
    have hinput : m.bits.length + numerator.bits.length + 3 ≤ D := by
      rw [Nat.size_eq_bits_len]
      omega
    have hmBound : mc ≤ 600 * D^2 :=
      hmc.trans (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hinput 2))
    have hpBound : pc ≤ 2000 * D^2 := hpc.trans (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hprec 2))
    change _ ≤ 4000 * D^2
    norm_num [MagnitudeMax.bankOf]
    change mc + (pc + (12 * P.bits.length + 11 + (12 * (2 ^ P).bits.length + 11 + _))) ≤ _
    rw [hpbits]
    nlinarith [hb.1, hb.2]
  · have hz : resetBank (MagnitudeMax.bankOf rhs) = (fun _ => 0) := by
      funext i
      by_cases h30 : i = 30 <;> by_cases h31 : i = 31 <;> by_cases h32 : i = 32 <;>
        simp_all [resetBank, MagnitudeMax.bankOf]
    simpa only [hz] using htb

end Maxwell.Cost.SourceMetadata
