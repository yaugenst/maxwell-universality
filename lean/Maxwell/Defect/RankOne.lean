import Mathlib.Analysis.InnerProductSpace.Spectrum
import Mathlib.Tactic

/-! Rank-one splitting on a selected eigenspace. -/
namespace Maxwell.Defect

open Module.End InnerProductSpace

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The first-order operator on the selected eigenspace. -/
noncomputable def rankOneSplit (lam δ : ℝ) (a : E) : E →ₗ[ℝ] E :=
  lam • LinearMap.id - δ • (rankOne ℝ a a).toLinearMap

@[simp] theorem rankOneSplit_apply (lam δ : ℝ) (a x : E) :
    rankOneSplit lam δ a x = lam • x - (δ * inner ℝ a x) • a := by
  simp [rankOneSplit, smul_smul]

theorem rankOneSplit_selected (lam δ : ℝ) (a : E) :
    rankOneSplit lam δ a a = (lam - δ * ‖a‖ ^ 2) • a := by
  simp [rankOneSplit_apply, sub_smul]

theorem rankOneSplit_orthogonal (lam δ : ℝ) (a x : E)
    (hx : inner ℝ a x = 0) : rankOneSplit lam δ a x = lam • x := by
  simp [hx]

/-- The selected eigenvalue's eigenspace is exactly the line generated by the
projected perturbation vector. Degeneracy of the unperturbed eigenvalue causes
no multiplicity in this split eigenvalue. -/
theorem rankOneSplit_eigenspace (lam δ : ℝ) (a : E) (hδ : δ ≠ 0) (ha : a ≠ 0) :
    eigenspace (rankOneSplit lam δ a) (lam - δ * ‖a‖ ^ 2) = ℝ ∙ a := by
  ext x
  rw [mem_eigenspace_iff, Submodule.mem_span_singleton]
  constructor
  · intro hx
    have hn : ‖a‖ ^ 2 ≠ 0 := pow_ne_zero _ (norm_ne_zero_iff.mpr ha)
    have hcoeff : (δ * ‖a‖ ^ 2) ≠ 0 := mul_ne_zero hδ hn
    have heq : (δ * ‖a‖ ^ 2) • x = (δ * inner ℝ a x) • a := by
      rw [rankOneSplit_apply, sub_smul] at hx
      exact sub_right_inj.mp hx.symm
    refine ⟨(δ * ‖a‖ ^ 2)⁻¹ * (δ * inner ℝ a x), ?_⟩
    rw [mul_smul, ← heq, smul_smul, inv_mul_cancel₀ hcoeff, one_smul]
  · rintro ⟨r, rfl⟩
    rw [map_smul, rankOneSplit_selected, smul_comm]

theorem rankOneSplit_selected_simple (lam δ : ℝ) (a : E)
    (hδ : δ ≠ 0) (ha : a ≠ 0) :
    Module.finrank ℝ (eigenspace (rankOneSplit lam δ a) (lam - δ * ‖a‖ ^ 2)) = 1 := by
  rw [rankOneSplit_eigenspace lam δ a hδ ha]
  exact finrank_span_singleton ha

omit [InnerProductSpace ℝ E] in
/-- The linear gap is strictly positive for a positive perturbation scale. -/
theorem rankOneSplit_gap (lam δ : ℝ) (a : E) (hδ : 0 < δ) (ha : a ≠ 0) :
    0 < δ * ‖a‖ ^ 2 ∧ |lam - (lam - δ * ‖a‖ ^ 2)| = δ * ‖a‖ ^ 2 := by
  have hp : 0 < δ * ‖a‖ ^ 2 := mul_pos hδ (sq_pos_of_pos (norm_pos_iff.mpr ha))
  exact ⟨hp, by rw [sub_sub_cancel]; exact abs_of_pos hp⟩

/-- A unit approximate eigenvector of a real symmetric finite-dimensional
operator lies within its residual norm of an actual eigenvalue. -/
theorem exists_eigenpair_near [FiniteDimensional ℝ E]
    (T : E →ₗ[ℝ] E) (hT : T.IsSymmetric) (v : E) (μ ε : ℝ)
    (hv : ‖v‖ = 1) (hres : ‖T v - μ • v‖ ≤ ε) :
    ∃ ν : ℝ, ∃ u : E, ‖u‖ = 1 ∧ T u = ν • u ∧ |ν - μ| ≤ ε := by
  classical
  let b := hT.eigenvectorBasis rfl
  let d := hT.eigenvalues rfl
  have hε : 0 ≤ ε := le_trans (norm_nonneg _) hres
  have hsum (x : E) : ∑ i, (b.repr x i) ^ 2 = ‖x‖ ^ 2 := by
    rw [← EuclideanSpace.real_norm_sq_eq]
    simp
  have hvsum : ∑ i, (b.repr v i) ^ 2 = 1 := by simpa [hv] using hsum v
  have hrcoord (i) : b.repr (T v - μ • v) i = (d i - μ) * b.repr v i := by
    simp only [map_sub, map_smul, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
    rw [show b.repr (T v) i = d i * b.repr v i from
      hT.eigenvectorBasis_apply_self_apply rfl v i]
    ring
  have hnear : ∃ i, |d i - μ| ≤ ε := by
    by_contra! hall
    have hsq (i) : ε ^ 2 < (d i - μ) ^ 2 := by
      have hi := hall i
      nlinarith [sq_abs (d i - μ)]
    obtain ⟨i₀, _, hi₀⟩ := Finset.sum_pos_iff_of_nonneg (fun i _ => sq_nonneg (b.repr v i)) |>.mp
      (show 0 < ∑ i, (b.repr v i) ^ 2 by rw [hvsum]; norm_num)
    have hstrict : ∑ i, ε ^ 2 * (b.repr v i) ^ 2 <
        ∑ i, ((d i - μ) * b.repr v i) ^ 2 := by
      apply Finset.sum_lt_sum
      · intro i _
        rw [mul_pow]
        exact mul_le_mul_of_nonneg_right (hsq i).le (sq_nonneg _)
      · exact ⟨i₀, Finset.mem_univ _, by rw [mul_pow]; exact mul_lt_mul_of_pos_right (hsq i₀) hi₀⟩
    rw [← Finset.mul_sum, hvsum, mul_one] at hstrict
    have hr : ∑ i, ((d i - μ) * b.repr v i) ^ 2 = ‖T v - μ • v‖ ^ 2 := by
      simpa only [hrcoord] using hsum (T v - μ • v)
    rw [hr] at hstrict
    nlinarith [norm_nonneg (T v - μ • v)]
  obtain ⟨i, hi⟩ := hnear
  exact ⟨d i, b i, b.orthonormal.norm_eq_one i, hT.apply_eigenvectorBasis rfl i, hi⟩

/-- A complementary lower bound excludes eigenvectors orthogonal to the
selected line even after an arbitrary perturbation of the stated norm. -/
theorem eigenvector_inner_ne_zero_of_gap
    (A T : E →ₗ[ℝ] E) (v x : E) (μ ν ε g : ℝ)
    (hgap : ∀ y : E, inner ℝ v y = 0 → g * ‖y‖ ≤ ‖A y - μ • y‖)
    (hpert : ∀ y : E, ‖T y - A y‖ ≤ ε * ‖y‖)
    (hclose : |ν - μ| ≤ ε) (hsmall : 2 * ε < g)
    (hx : x ≠ 0) (hTx : T x = ν • x) : inner ℝ v x ≠ 0 := by
  intro horth
  have hlower := hgap x horth
  have hupper : ‖A x - μ • x‖ ≤ (|ν - μ| + ε) * ‖x‖ := by
    calc
      ‖A x - μ • x‖ = ‖(ν - μ) • x - (T x - A x)‖ := by
        congr 1
        rw [hTx, sub_smul]
        abel
      _ ≤ ‖(ν - μ) • x‖ + ‖T x - A x‖ := norm_sub_le _ _
      _ ≤ |ν - μ| * ‖x‖ + ε * ‖x‖ := by
        rw [norm_smul, Real.norm_eq_abs]
        exact add_le_add (le_refl _) (hpert x)
      _ = (|ν - μ| + ε) * ‖x‖ := by ring
  have hn : 0 < ‖x‖ := norm_pos_iff.mpr hx
  nlinarith

/-- The nearby eigenspace has dimension at most one. This proves simplicity
from an operator gap, rather than assuming it as branch data. -/
theorem eigenspace_finrank_le_one_of_gap [FiniteDimensional ℝ E]
    (A T : E →ₗ[ℝ] E) (v : E) (μ ν ε g : ℝ)
    (hgap : ∀ y : E, inner ℝ v y = 0 → g * ‖y‖ ≤ ‖A y - μ • y‖)
    (hpert : ∀ y : E, ‖T y - A y‖ ≤ ε * ‖y‖)
    (hclose : |ν - μ| ≤ ε) (hsmall : 2 * ε < g) :
    Module.finrank ℝ (eigenspace T ν) ≤ 1 := by
  let f : eigenspace T ν →ₗ[ℝ] ℝ :=
    (innerₛₗ ℝ v).comp (eigenspace T ν).subtype
  have hf : Function.Injective f := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro x hx
    apply Subtype.ext
    by_contra hne
    have hn : (x : E) ≠ 0 := by simpa using hne
    exact eigenvector_inner_ne_zero_of_gap A T v x μ ν ε g hgap hpert hclose
      hsmall hn (mem_eigenspace_iff.mp x.property) hx
  simpa using LinearMap.finrank_le_finrank_of_injective hf

/-- An isolated simple eigenvalue survives a perturbation. Existence and
simplicity are conclusions; the hypotheses are only a unit reference
eigenvector, its complementary operator gap, and the perturbation norm. -/
theorem exists_simple_eigenpair_of_gap [FiniteDimensional ℝ E]
    (A T : E →ₗ[ℝ] E) (hT : T.IsSymmetric) (v : E) (μ ε g : ℝ)
    (hv : ‖v‖ = 1) (hAv : A v = μ • v)
    (hgap : ∀ y : E, inner ℝ v y = 0 → g * ‖y‖ ≤ ‖A y - μ • y‖)
    (hpert : ∀ y : E, ‖T y - A y‖ ≤ ε * ‖y‖) (hsmall : 2 * ε < g) :
    ∃ ν : ℝ, ∃ u : E, ‖u‖ = 1 ∧ T u = ν • u ∧ |ν - μ| ≤ ε ∧
      Module.finrank ℝ (eigenspace T ν) = 1 ∧ inner ℝ v u ≠ 0 := by
  have hr : ‖T v - μ • v‖ ≤ ε := by simpa [hAv, hv] using hpert v
  obtain ⟨ν, u, hu, hTu, hν⟩ := exists_eigenpair_near T hT v μ ε hv hr
  have hu0 : u ≠ 0 := by intro h; simp [h] at hu
  have hle := eigenspace_finrank_le_one_of_gap A T v μ ν ε g hgap hpert hν hsmall
  have hpos : 0 < Module.finrank ℝ (eigenspace T ν) := by
    apply Module.finrank_pos_iff_exists_ne_zero.mpr
    refine ⟨⟨u, mem_eigenspace_iff.mpr hTu⟩, ?_⟩
    intro h
    exact hu0 (congrArg Subtype.val h)
  exact ⟨ν, u, hu, hTu, hν, by omega,
    eigenvector_inner_ne_zero_of_gap A T v u μ ν ε g hgap hpert hν hsmall hu0 hTu⟩

/-- Choosing the positive sign turns a bound on the orthogonal component
into a bound on the entire normalized eigenvector. -/
theorem norm_sub_le_two_mul_orthogonal_component (v u : E)
    (hv : ‖v‖ = 1) (hu : ‖u‖ = 1) (hpos : 0 ≤ inner ℝ v u) :
    ‖u - v‖ ≤ 2 * ‖u - (inner ℝ v u) • v‖ := by
  have hα : inner ℝ v u ≤ 1 := by simpa [hv, hu] using real_inner_le_norm v u
  have hwhole := norm_sub_sq_real u v
  have hpart := norm_sub_sq_real u ((inner ℝ v u) • v)
  rw [hv, hu, real_inner_comm v u] at hwhole
  simp only [hu, inner_smul_right, real_inner_comm v u, norm_smul, Real.norm_eq_abs,
    abs_of_nonneg hpos, hv, mul_one] at hpart
  nlinarith [norm_nonneg (u - v), norm_nonneg (u - (inner ℝ v u) • v),
    mul_nonneg hpos (sub_nonneg.mpr hα)]

/-- Quantitative eigenvector control from the same operator gap. In the
paper's application, `ε = O(τ²)` and `g` is proportional to `τ`, so this
estimate is `O(τ)`. -/
theorem eigenvector_alignment_of_gap
    (A T : E →ₗ[ℝ] E) (v u : E) (μ ν ε g : ℝ)
    (hv : ‖v‖ = 1) (hu : ‖u‖ = 1) (hAv : A v = μ • v) (hTu : T u = ν • u)
    (hgap : ∀ y : E, inner ℝ v y = 0 → g * ‖y‖ ≤ ‖A y - μ • y‖)
    (hpert : ∀ y : E, ‖T y - A y‖ ≤ ε * ‖y‖)
    (hclose : |ν - μ| ≤ ε) (hg : 0 < g) (hpos : 0 ≤ inner ℝ v u) :
    ‖u - v‖ ≤ 4 * ε / g := by
  let y := u - (inner ℝ v u) • v
  have hy : inner ℝ v y = 0 := by simp [y, inner_sub_right, inner_smul_right, hv]
  have hAy : A y - μ • y = (ν - μ) • u - (T u - A u) := by
    simp only [y, map_sub, map_smul, hAv, hTu, smul_sub, sub_smul]
    rw [smul_comm μ (inner ℝ v u) v]
    abel
  have hb : g * ‖y‖ ≤ 2 * ε := by
    calc
      g * ‖y‖ ≤ ‖A y - μ • y‖ := hgap y hy
      _ = ‖(ν - μ) • u - (T u - A u)‖ := by rw [hAy]
      _ ≤ ‖(ν - μ) • u‖ + ‖T u - A u‖ := norm_sub_le _ _
      _ ≤ ε + ε := by
        have hp := hpert u
        simpa [norm_smul, hu, Real.norm_eq_abs] using add_le_add hclose hp
      _ = 2 * ε := by ring
  have hd := norm_sub_le_two_mul_orthogonal_component v u hv hu hpos
  apply (le_div_iff₀ hg).mpr
  change ‖u - v‖ ≤ 2 * ‖y‖ at hd
  nlinarith

private theorem norm_orthogonal_combination_sq (u x : E) (r s : ℝ)
    (hu : ‖u‖ = 1) (hx : ‖x‖ = 1) (horth : inner ℝ u x = 0) :
    ‖r • u - s • x‖ ^ 2 = r ^ 2 + s ^ 2 := by
  rw [norm_sub_sq_real]
  simp [norm_smul, hu, hx, inner_smul_left, inner_smul_right, horth, sq_abs]

/-- Every other eigenvalue stays outside the complementary spectral gap,
up to the perturbation norm. This also gives the linear branch separation. -/
theorem other_eigenvalue_away_of_gap
    (A T : E →ₗ[ℝ] E) (hT : T.IsSymmetric) (v u x : E) (μ ν ρ ε g : ℝ)
    (hu : ‖u‖ = 1) (hx : ‖x‖ = 1) (hTu : T u = ν • u) (hTx : T x = ρ • x)
    (hgap : ∀ y : E, inner ℝ v y = 0 → g * ‖y‖ ≤ ‖A y - μ • y‖)
    (hpert : ∀ y : E, ‖T y - A y‖ ≤ ε * ‖y‖)
    (hclose : |ν - μ| ≤ ε) (hsmall : 2 * ε < g) (hne : ν ≠ ρ) :
    g - ε ≤ |ρ - μ| := by
  have hu0 : u ≠ 0 := by intro h; simp [h] at hu
  have hα := eigenvector_inner_ne_zero_of_gap A T v u μ ν ε g hgap hpert hclose
    hsmall hu0 hTu
  have horth : inner ℝ u x = 0 := by
    have he := hT u x
    rw [hTu, hTx, real_inner_smul_left, real_inner_smul_right] at he
    have he' : (ν - ρ) * inner ℝ u x = 0 := by nlinarith
    exact (mul_eq_zero.mp he').resolve_left (sub_ne_zero.mpr hne)
  have hε : 0 ≤ ε := by
    have hh := hpert u
    rw [hu, mul_one] at hh
    exact le_trans (norm_nonneg _) hh
  by_contra! hρ
  let R := max |ν - μ| |ρ - μ|
  have hR : 0 ≤ R := le_trans (abs_nonneg _) (le_max_left _ _)
  have hRsmall : R + ε < g := by
    have : |ν - μ| < g - ε := by linarith
    have : R < g - ε := max_lt this hρ
    linarith
  let α := inner ℝ v u
  let β := inner ℝ v x
  let y := β • u - α • x
  have hyorth : inner ℝ v y = 0 := by
    simp only [y, inner_sub_right, inner_smul_right, α, β]
    ring
  have hynorm : ‖y‖ ^ 2 = β ^ 2 + α ^ 2 :=
    norm_orthogonal_combination_sq u x β α hu hx horth
  have hypos : 0 < ‖y‖ := by
    have : 0 < α ^ 2 := sq_pos_of_ne_zero hα
    nlinarith [norm_nonneg y, sq_nonneg β]
  have hTy : T y - μ • y = (β * (ν - μ)) • u - (α * (ρ - μ)) • x := by
    simp only [y, map_sub, map_smul, hTu, hTx, smul_sub, smul_smul]
    module
  have hTnorm : ‖T y - μ • y‖ ^ 2 =
      (β * (ν - μ)) ^ 2 + (α * (ρ - μ)) ^ 2 := by
    rw [hTy]
    exact norm_orthogonal_combination_sq u x _ _ hu hx horth
  have hνR : (ν - μ) ^ 2 ≤ R ^ 2 := by
    have := le_max_left |ν - μ| |ρ - μ|
    nlinarith [sq_abs (ν - μ), abs_nonneg (ν - μ)]
  have hρR : (ρ - μ) ^ 2 ≤ R ^ 2 := by
    have := le_max_right |ν - μ| |ρ - μ|
    nlinarith [sq_abs (ρ - μ), abs_nonneg (ρ - μ)]
  have hTbound : ‖T y - μ • y‖ ≤ R * ‖y‖ := by
    have hs : ‖T y - μ • y‖ ^ 2 ≤ R ^ 2 * ‖y‖ ^ 2 := by
      rw [hTnorm, hynorm, mul_pow, mul_pow]
      nlinarith [mul_le_mul_of_nonneg_left hνR (sq_nonneg β),
        mul_le_mul_of_nonneg_left hρR (sq_nonneg α)]
    nlinarith [norm_nonneg (T y - μ • y), mul_nonneg hR (norm_nonneg y)]
  have hh : g * ‖y‖ ≤ (R + ε) * ‖y‖ := by
    calc
      g * ‖y‖ ≤ ‖A y - μ • y‖ := hgap y hyorth
      _ = ‖(T y - μ • y) - (T y - A y)‖ := by congr 1; abel
      _ ≤ ‖T y - μ • y‖ + ‖T y - A y‖ := norm_sub_le _ _
      _ ≤ R * ‖y‖ + ε * ‖y‖ := add_le_add hTbound (hpert y)
      _ = (R + ε) * ‖y‖ := by ring
  nlinarith

/-- Quantitative simple-eigenpair stability, including the eigenvalue error,
signed eigenvector error, and separation from every other eigenvalue. -/
theorem isolated_eigenpair_stability [FiniteDimensional ℝ E]
    (A T : E →ₗ[ℝ] E) (hT : T.IsSymmetric) (v : E) (μ ε g : ℝ)
    (hv : ‖v‖ = 1) (hAv : A v = μ • v)
    (hgap : ∀ y : E, inner ℝ v y = 0 → g * ‖y‖ ≤ ‖A y - μ • y‖)
    (hpert : ∀ y : E, ‖T y - A y‖ ≤ ε * ‖y‖) (hsmall : 2 * ε < g) :
    ∃ ν : ℝ, ∃ u : E, ‖u‖ = 1 ∧ T u = ν • u ∧ |ν - μ| ≤ ε ∧
      Module.finrank ℝ (eigenspace T ν) = 1 ∧ 0 < inner ℝ v u ∧
      ‖u - v‖ ≤ 4 * ε / g ∧
      ∀ (ρ : ℝ) (x : E), ‖x‖ = 1 → T x = ρ • x → ν ≠ ρ →
        g - 2 * ε ≤ |ρ - ν| := by
  obtain ⟨ν, u₀, hu₀, hTu₀, hν, hdim, hinner⟩ :=
    exists_simple_eigenpair_of_gap A T hT v μ ε g hv hAv hgap hpert hsmall
  have hsign : ∃ u : E, ‖u‖ = 1 ∧ T u = ν • u ∧ 0 < inner ℝ v u := by
    by_cases hp : 0 < inner ℝ v u₀
    · exact ⟨u₀, hu₀, hTu₀, hp⟩
    · refine ⟨-u₀, by simpa using hu₀, by simp [hTu₀], ?_⟩
      rw [inner_neg_right]
      have : inner ℝ v u₀ < 0 := lt_of_le_of_ne (le_of_not_gt hp) hinner
      linarith
  obtain ⟨u, hu, hTu, hpos⟩ := hsign
  have hε : 0 ≤ ε := by
    have hh := hpert v
    rw [hv, mul_one] at hh
    exact le_trans (norm_nonneg _) hh
  have hg : 0 < g := by linarith
  refine ⟨ν, u, hu, hTu, hν, hdim, hpos,
    eigenvector_alignment_of_gap A T v u μ ν ε g hv hu hAv hTu hgap hpert hν hg hpos.le, ?_⟩
  intro ρ x hx hTx hne
  have hother := other_eigenvalue_away_of_gap A T hT v u x μ ν ρ ε g hu hx
    hTu hTx hgap hpert hν hsmall hne
  have htriangle := abs_sub_le ρ ν μ
  linarith

/-- Actual branch selection on a degenerate eigenspace, allowing an arbitrary
symmetric quadratic remainder. `δ` is the positive first-order split and
`ε` is the remainder bound. -/
theorem rankOneSplit_perturbed_branch [FiniteDimensional ℝ E]
    (T : E →ₗ[ℝ] E) (hT : T.IsSymmetric) (v : E) (lam δ ε : ℝ)
    (hv : ‖v‖ = 1) (hδ : 0 < δ)
    (hpert : ∀ y : E, ‖T y - rankOneSplit lam δ v y‖ ≤ ε * ‖y‖)
    (hsmall : 2 * ε < δ) :
    ∃ ν : ℝ, ∃ u : E, ‖u‖ = 1 ∧ T u = ν • u ∧ |ν - (lam - δ)| ≤ ε ∧
      Module.finrank ℝ (eigenspace T ν) = 1 ∧ 0 < inner ℝ v u ∧
      ‖u - v‖ ≤ 4 * ε / δ ∧
      ∀ (ρ : ℝ) (x : E), ‖x‖ = 1 → T x = ρ • x → ν ≠ ρ →
        δ - 2 * ε ≤ |ρ - ν| := by
  apply isolated_eigenpair_stability (rankOneSplit lam δ v) T hT v (lam - δ) ε δ hv
  · simpa [hv] using rankOneSplit_selected lam δ v
  · intro y hy
    rw [rankOneSplit_orthogonal lam δ v y hy, ← sub_smul, sub_sub_cancel,
      norm_smul, Real.norm_eq_abs, abs_of_pos hδ]
  · exact hpert
  · exact hsmall

/-- Normalizing the perturbation vector moves exactly its squared norm into
the splitting coefficient. -/
theorem rankOneSplit_normalize (lam δ : ℝ) (a : E) (ha : a ≠ 0) :
    rankOneSplit lam (δ * ‖a‖ ^ 2) (‖a‖⁻¹ • a) = rankOneSplit lam δ a := by
  have hn : ‖a‖ ≠ 0 := norm_ne_zero_iff.mpr ha
  ext y
  simp only [rankOneSplit_apply, inner_smul_left, RCLike.conj_to_real, smul_smul]
  congr 2
  field_simp

/-- Non-unit-vector form of the perturbed rank-one splitting theorem. -/
theorem rankOneSplit_perturbed_branch_nonunit [FiniteDimensional ℝ E]
    (T : E →ₗ[ℝ] E) (hT : T.IsSymmetric) (a : E) (lam δ ε : ℝ)
    (ha : a ≠ 0) (hδ : 0 < δ)
    (hpert : ∀ y : E, ‖T y - rankOneSplit lam δ a y‖ ≤ ε * ‖y‖)
    (hsmall : 2 * ε < δ * ‖a‖ ^ 2) :
    ∃ ν : ℝ, ∃ u : E, ‖u‖ = 1 ∧ T u = ν • u ∧
      |ν - (lam - δ * ‖a‖ ^ 2)| ≤ ε ∧
      Module.finrank ℝ (eigenspace T ν) = 1 ∧ 0 < inner ℝ (‖a‖⁻¹ • a) u ∧
      ‖u - ‖a‖⁻¹ • a‖ ≤ 4 * ε / (δ * ‖a‖ ^ 2) ∧
      ∀ (ρ : ℝ) (x : E), ‖x‖ = 1 → T x = ρ • x → ν ≠ ρ →
        δ * ‖a‖ ^ 2 - 2 * ε ≤ |ρ - ν| := by
  apply rankOneSplit_perturbed_branch T hT (‖a‖⁻¹ • a) lam (δ * ‖a‖ ^ 2) ε
  · simp [norm_smul, ha]
  · exact mul_pos hδ (sq_pos_of_pos (norm_pos_iff.mpr ha))
  · simpa only [rankOneSplit_normalize lam δ a ha] using hpert
  · exact hsmall

/-- A coordinate spectral gap gives the complementary operator lower bound
required by `isolated_eigenpair_stability`. This applies to the block diagonal
first-order reference after selecting the rank-one direction as one basis
vector. -/
theorem complementary_gap_of_diagonalization {ι : Type*} [Fintype ι]
    (b : OrthonormalBasis ι ℝ E) (A : E →ₗ[ℝ] E) (d : ι → ℝ) (i₀ : ι) (g : ℝ)
    (hg : 0 ≤ g)
    (hdiag : ∀ (y : E) (i : ι), b.repr (A y) i = d i * b.repr y i)
    (hdist : ∀ i, i ≠ i₀ → g ≤ |d i - d i₀|) :
    ∀ y : E, inner ℝ (b i₀) y = 0 → g * ‖y‖ ≤ ‖A y - d i₀ • y‖ := by
  classical
  intro y hy
  have hsum (x : E) : ∑ i, (b.repr x i) ^ 2 = ‖x‖ ^ 2 := by
    rw [← EuclideanSpace.real_norm_sq_eq]
    simp
  have hy₀ : b.repr y i₀ = 0 := by simpa only [b.repr_apply_apply] using hy
  have hrcoord (i : ι) : b.repr (A y - d i₀ • y) i = (d i - d i₀) * b.repr y i := by
    simp only [map_sub, map_smul, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul, hdiag]
    ring
  have hterm (i : ι) : g ^ 2 * (b.repr y i) ^ 2 ≤
      (b.repr (A y - d i₀ • y) i) ^ 2 := by
    rw [hrcoord, mul_pow]
    by_cases hi : i = i₀
    · simp [hi, hy₀]
    · have hd := hdist i hi
      have hs : g ^ 2 ≤ (d i - d i₀) ^ 2 := by
        nlinarith [sq_abs (d i - d i₀), abs_nonneg (d i - d i₀)]
      exact mul_le_mul_of_nonneg_right hs (sq_nonneg _)
  have hs := Finset.sum_le_sum (fun i (_ : i ∈ Finset.univ) => hterm i)
  rw [← Finset.mul_sum, hsum, hsum] at hs
  nlinarith [mul_nonneg hg (norm_nonneg y), norm_nonneg (A y - d i₀ • y)]

end Maxwell.Defect
