import Mathlib.Analysis.RCLike.Basic
import Mathlib.LinearAlgebra.Matrix.PosDef
import Mathlib.LinearAlgebra.Matrix.Integer
import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.NormNum

namespace Maxwell.Certificate
open Matrix
open scoped ComplexOrder

/-- An exact LDL proposal. The factors can be generated by any untrusted
program. Acceptance checks equality of every rational entry and every pivot. -/
structure LDLWitness (n : ℕ) where
  lower : Matrix (Fin n) (Fin n) ℚ
  diagonal : Fin n → ℚ

def LDLWitness.accepts {n : ℕ} (w : LDLWitness n)
    (a : Matrix (Fin n) (Fin n) ℚ) : Bool :=
  decide (a = w.lower * Matrix.diagonal w.diagonal * w.lower.transpose ∧
    ∀ i, 0 ≤ w.diagonal i)

/-- Exact rational acceptance implies positive semidefiniteness over the
reals. In particular the conclusion is not just rational-vector positivity. -/
theorem LDLWitness.sound {n : ℕ} (w : LDLWitness n)
    (a : Matrix (Fin n) (Fin n) ℚ) (h : w.accepts a = true) :
    (a.map ((↑) : ℚ → ℝ)).PosSemidef := by
  have hc : a = w.lower * Matrix.diagonal w.diagonal * w.lower.transpose ∧
      ∀ i, 0 ≤ w.diagonal i := of_decide_eq_true h
  rw [hc.1, Matrix.map_mul_ratCast, Matrix.map_mul_ratCast]
  have hd : ((Matrix.diagonal w.diagonal).map ((↑) : ℚ → ℝ)).PosSemidef := by
    have heq : (Matrix.diagonal w.diagonal).map ((↑) : ℚ → ℝ) =
        Matrix.diagonal (fun i => (w.diagonal i : ℝ)) := by
      ext i j
      by_cases hij : i = j <;> simp [Matrix.diagonal, hij]
    rw [heq]
    exact Matrix.PosSemidef.diagonal (fun i => Rat.cast_nonneg.mpr (hc.2 i))
  have ht : w.lower.transpose.map ((↑) : ℚ → ℝ) =
      (w.lower.map ((↑) : ℚ → ℝ)).conjTranspose := by
    ext i j
    simp
  rw [ht]
  exact hd.mul_mul_conjTranspose_same _

/-- Proof-producing certificates can use real rational literals directly.
The equality remains a kernel-checked proposition, not an executable receipt. -/
theorem real_ldl_sound {n : ℕ} (a l : Matrix (Fin n) (Fin n) ℝ)
    (d : Fin n → ℝ) (hid : a = l * Matrix.diagonal d * l.transpose)
    (hd : ∀ i, 0 ≤ d i) : a.PosSemidef := by
  rw [hid]
  simpa only [Matrix.conjTranspose_eq_transpose_of_trivial] using
    (Matrix.PosSemidef.diagonal hd).mul_mul_conjTranspose_same l

theorem ldl_apply {n : ℕ} (l : Matrix (Fin n) (Fin n) ℝ) (d : Fin n → ℝ)
    (i j : Fin n) :
    (l * Matrix.diagonal d * l.transpose) i j = ∑ k, l i k * d k * l j k := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply]
  congr 1
  ext k
  rw [← Matrix.mul_apply, Matrix.mul_diagonal]

end Maxwell.Certificate
